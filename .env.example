# =============================================================================
# VoltForge Backend — Environment Configuration Example
# =============================================================================
# Copy this file to .env and update with your actual credentials.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
VOLTFORGE_DB_URL=jdbc:mysql://localhost:3306/voltforge_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
VOLTFORGE_DB_USERNAME=root
VOLTFORGE_DB_PASSWORD=your_password_here

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=voltforge-realm
KEYCLOAK_CLIENT_ID=voltforge-app
KEYCLOAK_CLIENT_SECRET=your_client_secret_here
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/voltforge-realm
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/voltforge-realm/protocol/openid-connect/certs

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3000

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ── VoltForge AI Microservice ───────────────────────────────────────────────
VOLTFORGE_AI_URL=http://localhost:2002/voltForge-ai

# AVR firmware compiler for browser emulation
# REMOTE posts to AVR_COMPILER_URL. ARDUINO_CLI runs arduino-cli on this backend host.
AVR_COMPILER_MODE=REMOTE
AVR_COMPILER_URL=https://hexi.wokwi.com/build
ARDUINO_CLI_PATH=arduino-cli
AVR_COMPILER_TIMEOUT=45
